  "query": "\n            SELECT c.id, c.title, c.case_number, c.created_by\n            FROM cases c\n            JOIN case_assignments ca ON ca.case_id = c.id\n            WHERE ca.user_id = $1\n            ORDER BY c.created_at DESC\n            ",
