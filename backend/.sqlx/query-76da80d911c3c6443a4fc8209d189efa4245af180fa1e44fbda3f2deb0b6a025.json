{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.actor_id, u.email as actor_email, a.action, a.document_id, a.created_at\n        FROM audit_log a\n        JOIN users u ON u.id = a.actor_id\n        WHERE a.case_id = $1\n        ORDER BY a.seq ASC\n        ",
