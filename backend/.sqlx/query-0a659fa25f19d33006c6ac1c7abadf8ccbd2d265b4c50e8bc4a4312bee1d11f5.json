  "query": "\n            SELECT id, case_id, uploaded_by, title, doc_type, description, file_hash, version\n            FROM documents\n            WHERE case_id = $1 AND search_vector @@ plainto_tsquery('english', $2)\n            ORDER BY ts_rank(search_vector, plainto_tsquery('english', $2)) DESC\n            ",
