# Ledger Service env (see DESIGN.md §2, ARCHITECTURE.md §2)
PORT=3001
# mock = file-backed store (default, demo-safe). fabric = real Fabric Gateway path.
LEDGER_MODE=mock
# File persistence for mock mode (Option A). Mount a Railway Volume at /data.
# Single replica only — a JSON file is last-writer-wins with >1 replica.
LEDGER_FILE=/data/ledger.json
# Set LEDGER_NO_PERSIST=1 to disable file persistence (tests only).
#LEDGER_NO_PERSIST=
# Default logical org tag when POST /ledger/entries omits org_id (POLICE/COURT/FORENSICS).
#ORG_ID=
# DEMO ONLY — set to false to disable POST /ledger/demo/tamper|restore.
ALLOW_DEMO_ENDPOINTS=true
CHANNEL=chaindock-channel
CHAINCODE=chaindock
# Fabric Gateway connection (only used when LEDGER_MODE=fabric):
# Path to a Fabric connection-profile JSON (from fabric-samples/test-network).
FABRIC_PROFILE=
# PEM files for the Gateway identity (Org1 admin by default in test-network).
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
MSP_ID=Org1MSP
PEER_ENDPOINT=localhost:7051
# Override TLS root cert if the profile's paths are not reachable from here.
FABRIC_TLS_CERT_PATH=
