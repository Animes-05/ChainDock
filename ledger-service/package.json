{
  "name": "chaindock-ledger-service",
  "version": "1.0.0",
  "description": "ChainDock Ledger Service — HTTP wrapper over Hyperledger Fabric Gateway SDK (see DESIGN.md §2). Axum never talks to Fabric directly.",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "@hyperledger/fabric-gateway": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5"
  }
}
